# Runtime
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/sutra

# Auth.js Google OAuth. Callback URL: http://localhost:3001/auth/callback/google
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local development only; ignored in production.
DEV_AUTH_BYPASS=true

# OpenRouter. Keep provider credentials on the backend; never add them to VITE_*.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Optional OpenAI-compatible local providers.
# For Docker on Windows/macOS, use host.docker.internal to reach a host service.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=llama3.2
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_API_KEY=
LOCALAI_DEFAULT_MODEL=gpt-4o-mini

# Planned follow-on integrations (not consumed by the first auth/chat slice yet).
CHROMA_URL=http://localhost:8000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and backed up; changing it makes saved provider keys unreadable.
TOKEN_ENCRYPTION_KEY=
